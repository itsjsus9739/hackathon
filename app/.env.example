# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (recordatorios de citas y convocatorias)
RESEND_API_KEY=
CORREO_REMITENTE="CDE UNAB <onboarding@resend.dev>"

# Asistente de preguntas sobre los datos (/asistente)
# Proveedor: "abierto" (predeterminado: modelo abierto con API compatible con OpenAI) o "claude"
IA_PROVEEDOR=abierto
# Modelo abierto: Groq por defecto (console.groq.com → API Keys, plan gratuito)
IA_API_KEY=
# Opcionales: otro proveedor compatible (OpenRouter, Together, Ollama local…) u otro modelo
# IA_BASE_URL=https://api.groq.com/openai/v1
# IA_MODELO=openai/gpt-oss-120b
# Solo si IA_PROVEEDOR=claude
ANTHROPIC_API_KEY=
# Conexión de SOLO LECTURA con el rol ia_lectura (Supabase → Connect → Transaction pooler,
# usuario ia_lectura.<project-ref>). Nunca uses aquí el usuario postgres.
IA_DATABASE_URL=

# Protege /api/cron/* (Vercel Cron envía este valor como Bearer)
CRON_SECRET=

# Calendario (/agenda): URL del proyecto Flask de calendario-cde/ desplegado en Vercel
CALENDARIO_URL=
